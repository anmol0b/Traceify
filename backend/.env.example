# Required
GROQ_API_KEY=your_groq_key            # https://console.groq.com
RAPIDAPI_KEY=your_rapidapi_key        # https://rapidapi.com — subscribe to twitter241
# Optional: Postgres with pgvector (e.g. Neon). Enables caching + semantic search.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Optional
ALLOWED_ORIGINS=http://localhost:3000
# GROQ_MODEL_FAST=openai/gpt-oss-20b
# GROQ_MODEL_SMART=openai/gpt-oss-120b
# CACHE_TTL_HOURS=24
