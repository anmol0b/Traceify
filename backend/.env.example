# Required
GROQ_API_KEY=your_groq_key            # https://console.groq.com
RAPIDAPI_KEY=your_rapidapi_key        # https://rapidapi.com — subscribe to twitter241
SUPABASE_URL=https://xxx.supabase.co  # optional: enables caching + semantic search
SUPABASE_KEY=your_service_role_key    # server-side only; never expose to the browser

# Optional
ALLOWED_ORIGINS=http://localhost:3000
