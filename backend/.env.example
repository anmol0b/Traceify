# Required
GROQ_API_KEY=your_groq_key            # https://console.groq.com
RAPIDAPI_KEY=your_rapidapi_key        # https://rapidapi.com — subscribe to twitter241
# Optional: Postgres with pgvector (e.g. Neon). Enables the persistent cache, the HNSW index and feedback storage.
# Without it, profiles and embeddings are kept in memory.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Optional
ALLOWED_ORIGINS=http://localhost:3000
# GROQ_MODEL_FAST=openai/gpt-oss-20b
# GROQ_MODEL_SMART=openai/gpt-oss-120b
# CACHE_TTL_HOURS=24
# LLM_TEMPERATURE=0.3
# LLM_MAX_COMPLETION_TOKENS=4096
# CONTEXT_MAX_TWEET_CHARS=10000   # 0 sends every tweet (best answers; needs a paid Groq tier)
# RETRIEVAL_LIMIT=8
# RETRIEVAL_MIN_SIMILARITY=0.5
# ANALYZE_ON_INGEST=true
